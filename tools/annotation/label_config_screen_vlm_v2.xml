<View>
  <Header value="知行智学｜屏幕流多模态证据标注 V2" />
  <Text name="scope" value="只标注视频内容与模型证据。不得据此推断观看者兴趣、专注、能力或学习效果。" />
  <View style="display:flex; gap:16px;">
    <View style="width:68%;">
      <Video name="video" value="$video" />
      <VideoRectangle name="region" toName="video" strokeWidth="2">
        <Label value="平台 UI" background="#64748B" />
        <Label value="视频正文" background="#2563EB" />
        <Label value="字幕或课件" background="#16A34A" />
        <Label value="弹幕或评论" background="#F59E0B" />
        <Label value="广告或推荐" background="#DC2626" />
        <Label value="无法判断" background="#A855F7" />
      </VideoRectangle>
      <Choices name="content_type" toName="video" choice="single" showInline="true">
        <Choice value="知识讲解" /><Choice value="技术演示" /><Choice value="新闻资讯" />
        <Choice value="剧情娱乐" /><Choice value="广告带货" /><Choice value="平台 UI 或非内容" />
        <Choice value="内容不确定" />
      </Choices>
      <Choices name="ui_interference" toName="video" choice="single" showInline="true">
        <Choice value="无" /><Choice value="轻度" /><Choice value="中度" /><Choice value="重度" /><Choice value="无法判断" />
      </Choices>
    </View>
    <View style="width:32%;">
      <Header value="同源自动证据" />
      <Text name="asr" value="$asr" />
      <Choices name="asr_quality" toName="video" choice="single">
        <Choice value="ASR 正确" /><Choice value="ASR 部分错误" /><Choice value="ASR 错误或不完整" /><Choice value="无音轨或不可判定" />
      </Choices>
      <Text name="ocr" value="$ocr" />
      <Choices name="ocr_text_source" toName="video" choice="multiple">
        <Choice value="视频正文" /><Choice value="视频字幕" /><Choice value="课件或屏幕内容" />
        <Choice value="平台 UI" /><Choice value="弹幕" /><Choice value="评论" /><Choice value="广告" />
        <Choice value="OCR 错误" /><Choice value="无法判断" />
      </Choices>
      <Text name="vlm" value="$vlm" />
      <Choices name="vlm_quality" toName="video" choice="single">
        <Choice value="VLM 正确" /><Choice value="VLM 部分正确" /><Choice value="VLM 不完整" />
        <Choice value="VLM 幻觉" /><Choice value="证据不足，不能判定" />
      </Choices>
      <Choices name="vlm_error_type" toName="video" choice="multiple">
        <Choice value="把平台 UI 当作内容" /><Choice value="虚构物体" /><Choice value="虚构动作" />
        <Choice value="遗漏关键实体" /><Choice value="遗漏关键动作" /><Choice value="忽略字幕主题" />
        <Choice value="与 OCR 或 ASR 冲突" /><Choice value="只描述视觉表面" /><Choice value="无明显错误" />
      </Choices>
      <Header value="人工结论" />
      <TextArea name="topic" toName="video" rows="3" placeholder="只描述这段视频的真实主题或知识内容；不评价观看者。" />
      <Choices name="evidence_status" toName="video" choice="single">
        <Choice value="内容证据充分" /><Choice value="存在冲突，需要拒答" /><Choice value="证据不足，拒答" />
      </Choices>
      <TextArea name="correction" toName="video" rows="3" placeholder="记录可被画面、OCR 或 ASR 支持的纠错事实。" />
    </View>
  </View>
</View>
